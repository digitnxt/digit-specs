    {
      "name": "JBAC",
      "item": [
        {
          "name": "Create JBAC Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-Id",
                "value": "RJ"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Individual Config Rule\",\n    \"pathPattern\": \"/individual/v3/configs\",\n    \"methods\": [\"POST\"],\n    \"enforcement\": \"REQUIRED\",\n    \"parentImpliesChildren\": true,\n    \"extractJurisdiction\": {\n        \"sources\": [\n                    {\n                        \"type\": \"HEADER\",\n                        \"key\": \"X-Jurisdiction-Id\"\n                    },\n                    {\n                        \"type\": \"BODY_FIELD\",\n                        \"path\": \"jurisdiction.id\"\n                    },\n                    {\n                        \"type\":\"QUERY_PARAM\",\n                        \"key\":\"jurisdiction\"\n                    }\n                ],\n                \"required\": true\n        }\n}\n"
            },
            "url": {
              "raw": "{{baseUrl}}/jbac/rules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jbac",
                "rules"
              ]
            }
          },
          "response": []
        },
