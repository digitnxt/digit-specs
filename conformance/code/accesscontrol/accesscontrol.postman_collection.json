              "raw": "{\n    \"name\": \"Updated Boundary Rule\",\n    \"extractJurisdiction\": {\n            \"sources\": [\n                {\n                    \"type\": \"HEADER\",\n                    \"key\": \"X-Jurisdiction-Id\"\n                },\n                {\n                    \"type\": \"BODY_JSONPATH\",\n                    \"path\": \"$.property.address.localityCode\"\n                }\n            ],\n           \"required\": true\n    }\n\n}"
