		{
			"name": "Canonical Template Management",
			"description": "Header-free twins of Template Management. Every X-* header moves into `requestMetadata`; the payload sits under `data`; query parameters stay query parameters. Responses are wrapped in `{responseMetadata, data}`.",
			"item": [
				{
					"name": "Create template - Canonical",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestMetadata\": {\n    \"ts\": {{ts}},\n    \"msgId\": \"{{ts}}|en_IN\",\n    \"requestId\": \"f98d1ed5-f978-40ca-b586-3f3567623225\",\n    \"correlationId\": \"5d9c1f60-6d0e-4c1e-9a4e-2b7a1f3c8e10\",\n    \"tenantId\": \"{{tenantId}}\",\n    \"userInfo\": { \"userId\": \"create-user\" }\n  },\n  \"data\": {\n    \"templateCode\": \"orgId\",\n    \"config\": {\n      \"template\": \"{ORG}-{DATE:yyyymmdd}-{SEQ}-{RAND}\",\n      \"sequence\": { \"scope\": \"GLOBAL\", \"start\": 1, \"padding\": { \"length\": 4, \"char\": \"0\" } },\n      \"random\": { \"length\": 2, \"charset\": \"A-Z0-9\" }\n    }\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v3/canonical/template",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"canonical",
								"template"
							]
						}
					},
					"response": []
				},
				{
					"name": "Update template - Canonical",
					"request": {
						"method": "PUT",
