	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// canonical requests carry the request time in requestMetadata.ts (epoch ms);",
					"// Postman's built-in {{$timestamp}} is seconds, which fails the 13-digit minimum",
					"pm.collectionVariables.set('ts', Date.now());"
				]
			}
		}
	],
