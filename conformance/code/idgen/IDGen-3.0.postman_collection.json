								"template"
							]
						}
					},
					"response": []
				},
				{
					"name": "Search template - Canonical",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestMetadata\": {\n    \"ts\": {{ts}},\n    \"msgId\": \"{{ts}}|en_IN\",\n    \"requestId\": \"f98d1ed5-f978-40ca-b586-3f3567623225\",\n    \"correlationId\": \"5d9c1f60-6d0e-4c1e-9a4e-2b7a1f3c8e10\",\n    \"tenantId\": \"{{tenantId}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v3/canonical/template?ids=25e0ec85-92ab-4c6a-9cd9-b86ed1cc3493,cbe8aacd-a4f1-4a5d-99ed-11caeb7d5790&templateCode=orgId&version=v1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"canonical",
								"template"
							],
							"query": [
								{
									"key": "ids",
									"value": "25e0ec85-92ab-4c6a-9cd9-b86ed1cc3493,cbe8aacd-a4f1-4a5d-99ed-11caeb7d5790"
								},
								{
									"key": "templateCode",
									"value": "orgId"
								},
								{
									"key": "version",
									"value": "v1"
								}
							]
						},
						"description": "Search criteria stay query parameters, exactly as on the 3.0 route; the body carries requestMetadata alone. No user id is read.\n\nNOTE — Postman prunes the body from GET requests by default: on import an exported cURL shows `--data ''`, and newman sends nothing, so the service answers 400 MISSING_HEADER requestMetadata.tenantId. This request sets `protocolProfileBehavior.disableBodyPruning: true`, which keeps the body on import and on send. Keep that flag if you copy this request."
					},
					"response": [],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					}
				},
