								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestMetadata\": {\n    \"ts\": {{ts}},\n    \"msgId\": \"{{ts}}|en_IN\",\n    \"requestId\": \"f98d1ed5-f978-40ca-b586-3f3567623225\",\n    \"correlationId\": \"5d9c1f60-6d0e-4c1e-9a4e-2b7a1f3c8e10\",\n    \"tenantId\": \"{{tenantId}}\",\n    \"userInfo\": { \"userId\": \"update-user\" }\n  },\n  \"data\": {\n    \"templateCode\": \"orgId\",\n    \"config\": { \"template\": \"{ORG}-{SEQ}\" }\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v3/canonical/template",
