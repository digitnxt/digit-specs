							"raw": "{\n  \"requestMetadata\": {\n    \"ts\": {{ts}},\n    \"msgId\": \"{{ts}}|en_IN\",\n    \"requestId\": \"f98d1ed5-f978-40ca-b586-3f3567623225\",\n    \"correlationId\": \"5d9c1f60-6d0e-4c1e-9a4e-2b7a1f3c8e10\",\n    \"tenantId\": \"{{tenantId}}\",\n    \"userInfo\": { \"userId\": \"delete-user\" }\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/v3/canonical/template?templateCode=orgId&version=v2",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"canonical",
								"template"
							],
							"query": [
								{
									"key": "templateCode",
									"value": "orgId"
								},
								{
									"key": "version",
									"value": "v2"
								}
							]
						},
						"description": "templateCode and version stay query parameters. Requires requestMetadata.userInfo.userId, mirroring the 3.0 route's X-User-ID demand."
					},
					"response": []
				}
			]
