# flyway -url=$DB_URL -table=$SCHEMA_TABLE -user=$FLYWAY_USER -password=$FLYWAY_PASSWORD -locations=$FLYWAY_LOCATIONS -baselineOnMigrate=true -outOfOrder=true migrate

export DB_URL=jdbc:postgresql://localhost:5434/postgres
export SCHEMA_TABLE=individual_schema  
export FLYWAY_USER=postgres
export FLYWAY_PASSWORD=password
export FLYWAY_LOCATIONS=filesystem:./migrations
export FLYWAY_SCHEMAS=public
export FLYWAY_DEFAULT_SCHEMA=public