    {
      "name": "JBAC",
      "item": [
        {
          "name": "Create JBAC rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const id = (body && body.rule && body.rule.id) || (body && body.id);",
                  "  if (id) { pm.collectionVariables.set('jbacRuleId', id); console.log('jbacRuleId=' + id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\":         \"Employee jurisdiction guard\",\n  \"pathPattern\":  \"/employee/v3/employees\",\n  \"methods\":      [\"POST\",\"PUT\",\"PATCH\"],\n  \"enforcement\":  \"REQUIRED\",\n  \"parentImpliesChildren\": true,\n  \"extractJurisdiction\": {\n    \"required\": true,\n    \"sources\": [\n      { \"from\": \"body\", \"path\": \"$.jurisdictions[*].boundaryRelation[*].code\" }\n    ]\n  },\n  \"description\":  \"All employee writes must be within caller's jurisdictions\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jbac/rules/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jbac",
                "rules",
                ""
              ]
            }
          },
          "response": []
        },
