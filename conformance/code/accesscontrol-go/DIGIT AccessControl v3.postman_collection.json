      "name": "RBAC",
      "item": [
        {
          "name": "Create RBAC rule",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const id = (body && body.rule && body.rule.id) || (body && body.id);",
                  "  if (id) { pm.collectionVariables.set('rbacRuleId', id); console.log('rbacRuleId=' + id); }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              },
              {
                "key": "X-User-ID",
                "value": "{{userId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleNames\":  [\"EMPLOYEE_ADMIN\"],\n  \"httpMethod\": \"POST\",\n  \"path\":       \"/ransom/v3/employees\",\n  \"effect\":     \"ALLOW\",\n  \"priority\":   100,\n  \"enabled\":    true,\n  \"description\":\"HR admins can create employees\"\n}"
            },
            "url": {
