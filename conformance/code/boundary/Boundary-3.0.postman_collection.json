 "item": [
  {
   "name": "Boundary",
   "item": [
    {
     "name": "Create boundaries",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "X-Tenant-ID",
        "value": "{{tenantId}}",
        "type": "text"
       },
       {
        "key": "X-User-ID",
        "value": "{{userId}}",
        "type": "text"
       },
       {
        "key": "X-Request-ID",
        "value": "req-{{ts}}",
        "type": "text"
       },
       {
        "key": "Content-Type",
        "value": "application/json",
        "type": "text"
       }
      ],
      "url": "{{baseUrl}}/v3/boundaries",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"boundary\": [\n    {\n      \"code\": \"{{rootBoundaryCode}}\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [77.5946, 12.9716]\n      },\n      \"additionalAttributes\": {\n        \"name\": \"Postman City\"\n      }\n    },\n    {\n      \"code\": \"{{childBoundaryCode}}\",\n      \"geometry\": {\n        \"type\": \"Point\",\n        \"coordinates\": [77.6, 12.98]\n      }\n    }\n  ]\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "const body = pm.response.json();",
         "if (body.boundary && body.boundary.length) { pm.collectionVariables.set('boundaryId', body.boundary[0].id); }"
        ],
        "type": "text/javascript"
       }
      }
     ]
    },
    {
     "name": "Search boundaries",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "X-Tenant-ID",
        "value": "{{tenantId}}",
        "type": "text"
       }
      ],
      "url": "{{baseUrl}}/v3/boundaries?codes={{rootBoundaryCode}}&codes={{childBoundaryCode}}&limit=20&offset=0"
     },
     "response": []
    },
    {
     "name": "Search boundaries by point (geo)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "X-Tenant-ID",
        "value": "{{tenantId}}",
        "type": "text"
       }
      ],
      "url": "{{baseUrl}}/v3/boundaries?latitude={{latitude}}&longitude={{longitude}}&limit=20&offset=0",
      "description": "PostGIS point-in-polygon search (ST_Contains on the geom column). Returns boundaries whose geometry contains the point. Boundaries created before the geo migration have geom NULL and never match until updated."
     },
     "response": []
    },
    {
