+              errors:
+                type: array
+                items: { $ref: '#/components/schemas/Error' }
+
+    GenerateBillCriteria:
+      type: object
+      description: Criteria for generating one or more bills from eligible FROZEN?ACTIVE demands under a BusinessService.
+      required:
+        - businessServiceCode
+        - consumerCode
+      properties:
+        businessServiceCode:
+          type: string
+          minLength: 2
+          maxLength: 32
