+path:
+  /v3/otp/generate:
+    post:
+      tag: [otp]
+      summary: generate an otp and send via notification service
+      description: >
+        create an otprecord, store hashed otp, call notification service.
+        return a requestid for subsequent operation.
+      operationid: generateotp
+      parameter:
+        - $ref: '#/component/parameter/tenantheader'
+        - $ref: '#/component/parameter/requestid'
+      requestbody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/component/schema/generateotprequest'
+      response:
+        '201':
+          description: otp generated
+          header:
+            x-response-time:
+              $ref: '#/component/header/x-response-time'
+            x-response-timestamp:
+              $ref: '#/component/header/x-response-timestamp'
+            x-request-id:
+              $ref: '#/component/header/x-request-id'
+            x-correlation-id:
+              $ref: '#/component/header/x-correlation-id'
+            x-tenant-id:
+              $ref: '#/component/header/x-tenant-id'
+            x-rate-limit:
+              $ref: '#/component/header/x-rate-limit'
+            x-rate-limit-remaining:
+              $ref: '#/component/header/x-rate-limit-remaining'
+            x-rate-limit-reset:
+              $ref: '#/component/header/x-rate-limit-reset'
+          content:
+            application/json:
+              schema:
+                $ref: '#/component/schema/generateotpresponse'
+        '400':
+          $ref: '#/component/response/badrequest'
+        '429':
+          $ref: '#/component/response/toomanyrequest'
+        '503':
+          description: notification service temporarily unavailable
+          header:
+            x-response-time:
+              $ref: '#/component/header/x-response-time'
+            x-response-timestamp:
+              $ref: '#/component/header/x-response-timestamp'
+            x-request-id:
